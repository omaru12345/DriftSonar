<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>DriftSonar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- 輸出コンプライアンス (TASK-171/#206): E2E 暗号 DM がコア機能のため「暗号を使用する」= true。
	     独自暗号は無く CryptoKit 標準アルゴリズム(X25519/Ed25519/AES-GCM/HKDF/SHA-2)のみ = EAR マスマーケット
	     例外(5D992.c)に該当。ASC の追問には「標準暗号・マスマーケット例外に該当」と回答する。
	     ※ 例外利用には米 BIS への年次自己分類レポート提出義務あり(運用側で対応)。詳細 docs/app-store-release.md。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<!-- TASK-172: 近接オフライン通信のみに使用。位置情報は追跡しないことを明記（GL 5.1 審査対策・CoreLocation は不使用） -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>近くのユーザーをBluetooth LEで検出し、メッセージをオフグリッドで直接伝播するためだけに使用します。位置情報の追跡には一切使用しません。</string>
	<!-- TASK-187: 投稿に添付する写真・動画の選択に使用。位置情報(EXIF)は保存時に除去します。 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>投稿に添付する写真・動画を選ぶために写真ライブラリへアクセスします。位置情報などのメタデータは添付時に除去されます。</string>
	<!-- TASK-131: DM 相手の安全番号 QR を対面で読み取り、鍵のすり替え(中間者攻撃)がないか確認するためだけに使用します。 -->
	<key>NSCameraUsageDescription</key>
	<string>DM相手の安全番号QRコードを読み取り、鍵がすり替えられていないか確認するためにカメラを使用します。撮影内容は保存も送信もされません。</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchScreenBackground</string>
		<key>UIImageName</key>
		<string>DriftSonarLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
